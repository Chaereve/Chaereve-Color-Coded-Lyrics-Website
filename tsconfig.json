{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["astro/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "admin/config.d.ts"],
  "exclude": ["dist", "node_modules", "workers"]
}
