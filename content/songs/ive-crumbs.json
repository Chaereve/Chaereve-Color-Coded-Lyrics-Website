    {
      "label": "Verse 1",
      "lines": [
        {
          "memberIds": [
            "wonyoung"
          ],
          "text": "밤이 내려앉아 창가에",
          "romanization": "bami naerae-anja chwang-gae-e",
          "translation": "The night settles on the windowsill"
        },
        {
          "memberIds": [
            "wonyoung"
          ],
          "text": "떨어진 별 하나 줍지",
          "romanization": "tteoreon seol hana jjujji",
          "translation": "I pick up one fallen star"
        },
        {
          "memberIds": [
            "gacrux"
          ],
          "text": "작은 빛은 거울처럼 반짝",
          "romanization": "jageun bicheun geoul-cheoreom bandjak",
          "translation": "A tiny light, glimmering like a mirror"
        },
        {
          "memberIds": [
            "ley"
          ],
          "text": "우리 둘만의 암호야",
          "romanization": "uri dulman-ui amhoya",
          "translation": "It's a secret code just for us two"
        }
      ]
    },
    {
      "label": "Pre-Chorus",
      "lines": [
        {
          "memberIds": [
            "jisoo"
          ],
          "text": "줍기 좋게 줄을 맞춰",
          "romanization": "jupgi johege jureul matjyo",
          "translation": "Neatly lined up, just right for picking"
        },
        {
          "memberIds": [
            "liz"
          ],
          "text": "손끝에 닿으면 따뜻해",
          "romanization": "sonkkeute dasseumyeon ttatteuthae",
          "translation": "The moment it touches my fingertips, it is warm"
        },
        {
          "memberIds": [],
          "text": "하나하나 모으면 빛이 될 거야",
          "romanization": "hanahana moeumyeon bichi dol geoya",
          "translation": "Gather them one by one and they will become light",
          "type": "all"
        }
      ]
    },
    {
      "label": "Chorus",
      "lines": [
        {
          "memberIds": [],
          "text": "We are the crumbs of a shining day",
          "translation": "We are the crumbs of a shining day",
          "type": "all"
        },
        {
          "memberIds": [],
          "text": "흩어져도 다시 빛나",
          "romanization": "hichyeojeodo dasi btinna",
          "translation": "Even scattered, we shine again",
          "type": "all"
        },
        {
          "memberIds": [],
          "text": "밤새 모은 별을 하늘에 두고",
          "romanization": "bamsae moun seoreul haneure daigo",
          "translation": "The stars I gathered through the night, I leave in the sky",
          "type": "all"
        },
        {
          "memberIds": [],
          "text": "내일을 향해 걸어가",
          "romanization": "nae-ireul hyanghae georeoga",
          "translation": "I walk toward tomorrow",
          "type": "all"
        },
        {
          "memberIds": [
            "eunchae"
          ],
          "text": "빛나, 빛나",
          "romanization": "btinna, btinna",
          "translation": "Shine, shine",
          "type": "adlib",
          "note": "Adlib from the demo MV placeholder — add only when it is needed and sourced."
        }
      ]
    },
    {
      "label": "Verse 2",
      "lines": [
        {
          "memberIds": [
            "eunchae"
          ],
          "text": "거리 끝에 환등이 켜지면",
          "romanization": "geori kkeunde hwandungi kkeumyeomyeon",
          "translation": "When the street lamps light at the end of the road"
        },
        {
          "memberIds": [
            "eunchae"
          ],
          "text": "그림자도 반짝반짝",
          "romanization": "geurimagdo bandjakbandjak",
          "translation": "Even the shadows sparkle"
        },
        {
          "memberIds": [
            "wonyoung"
          ],
          "text": "네가 남긴 자취가",
          "romanization": "nega namgin jachuga",
          "translation": "The trace you left behind"
        },
        {
          "memberIds": [
            "liz"
          ],
          "text": "발밑에서 꽃피워",
          "romanization": "balmiteseo kkotpiwo",
          "translation": "Blooms beneath my feet"
        }
      ]
    },
