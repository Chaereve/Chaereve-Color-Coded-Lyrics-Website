    {
      "label": "Bridge",
      "lines": [
        {
          "memberIds": [],
          "text": "기다린 것들이 하나로",
          "romanization": "gidarineun geotdeul-i haroro",
          "translation": "The things I waited for become one"
        },
        {
          "memberIds": [
            "haein",
            "mira"
          ],
          "text": "함께 보는 아침이니까|이 밤도 곧 지나가",
          "romanization": "hamkke boneun achimi-nikka | i bamdo goot jijnaga",
          "translation": "Because it is a morning we watch together | This night will soon pass",
          "note": "Duet line — text split per member with the | separator."
        },
        {
          "memberIds": [],
          "text": "하늘을 채우는 빛이 돼",
          "romanization": "haneureul chaeuneun bichi dwae",
          "translation": "Becoming light that fills the sky",
          "type": "all"
