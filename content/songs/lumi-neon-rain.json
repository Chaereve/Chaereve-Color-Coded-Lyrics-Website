      "label": "Verse 1",
      "lines": [
        {
          "memberIds": [
            "haein"
          ],
          "text": "네온사인 아래 비가 떨어져",
          "romanization": "neonsain arae biga tteoreojyeo",
          "translation": "Rain falling beneath the neon signs"
        },
        {
          "memberIds": [
            "haein"
          ],
          "text": "유리창에 지워지지 않아",
          "romanization": "yurichwange jiwoddoji anha",
          "translation": "It doesn't wipe off the glass"
        },
        {
          "memberIds": [
            "mira"
          ],
          "text": "발밑이 거울이 돼",
          "romanization": "bambidi geururi dwae",
          "translation": "The ground under my feet becomes a mirror"
        },
        {
          "memberIds": [
            "mira"
          ],
          "text": "색색으로 번져",
          "romanization": "saeksaek-euro byeonjyeo",
          "translation": "Spreading in every color"
        }
      ]
    },
    {
      "label": "Pre-Chorus",
      "lines": [
        {
          "memberIds": [
            "tayo"
          ],
          "text": "우산 없이 걸었어",
          "romanization": "usaneopsi georeosseo",
          "translation": "I walked without an umbrella"
        },
        {
          "memberIds": [
            "sol"
          ],
          "text": "젖은 밤은 반짝여",
          "romanization": "jotdeun bameun bandjagyeo",
          "translation": "A wet night sparkles"
        }
      ]
    },
    {
      "label": "Chorus",
      "lines": [
        {
          "memberIds": [],
          "text": "Neon rain, fall on me",
          "translation": "Neon rain, fall on me",
          "type": "all"
        },
        {
          "memberIds": [],
          "text": "비속에서도 빛나는",
          "romanization": "bisogeudeseo btinnaneun",
          "translation": "Even in the rain, shining"
        },
        {
          "memberIds": [],
          "text": "우리 도시의 불빛이야",
          "romanization": "uri dosi-ui bulbichiya",
          "translation": "The lights of our city",
          "type": "all"
        },
        {
          "memberIds": [],
          "text": "Soaked in color, we are alive",
          "translation": "Soaked in color, we are alive",
          "type": "all"
        },
        {
