---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---
<nav aria-label="Đường dẫn (breadcrumb)" class="overflow-x-auto scroll-x">
  <ol class="flex items-center gap-1.5 whitespace-nowrap py-2 text-xs text-ink-muted">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && (
            <span aria-hidden="true" class="text-ink-faint">
              ›
            </span>
          )}
          {item.href ? (
            <a href={item.href} class="hover:text-ink">
              {item.label}
            </a>
          ) : (
            <span class="text-ink" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
