---
import { breadcrumbJsonLd } from '../lib/seo';
import type { BreadcrumbItem } from '../lib/seo';

interface Props {
  /** Home is always included automatically. */
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const all: BreadcrumbItem[] = [{ name: 'Home', url: '/' }, ...items];
const site = new URL(Astro.site ?? 'http://localhost:4321');
---

<nav aria-label="Breadcrumb">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd(all, site))} />
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-[0.8125rem] text-muted">
    {all.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i < all.length - 1 ? (
          <a class="transition-colors hover:text-fg" href={item.url}>{item.name}</a>
        ) : (
          <span aria-current="page" class="font-medium text-fg">{item.name}</span>
        )}
        {i < all.length - 1 && <span aria-hidden="true" class="text-line">/</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  nav.breadcrumb {
    margin-bottom: 1.25rem;
  }
</style>
