---
interface Props {
  autofocus?: boolean;
  large?: boolean;
}
const { autofocus = false, large = false } = Astro.props;
---
<form action="/search/" method="get" role="search" class="flex w-full items-center gap-2">
  <label class="sr-only" for="search-input">Tìm bài hát, nghệ sĩ, thành viên</label>
  <div class="relative flex-1">
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-faint"
      ><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg
    >
    <input
      type="search"
      id="search-input"
      name="q"
      placeholder="Tìm bài hát, nghệ sĩ, thành viên…"
      autocomplete="off"
      autofocus={autofocus}
      class:list={[
        'w-full rounded-lg border border-black/10 dark:border-white/10 bg-surface-raised py-3 pl-11 pr-4 text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none',
        large ? 'min-h-[52px] text-base' : 'min-h-touch text-sm',
      ]}
    />
  </div>
  <button type="submit" class:list={['btn-primary shrink-0', large ? 'min-h-[52px] px-5' : '']}>Tìm</button>
</form>
