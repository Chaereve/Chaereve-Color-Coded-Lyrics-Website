---
import type { Song } from '../lib/types';
import { computeDistribution } from '../lib/distribution';

interface Props {
  song: Song;
}
const { song } = Astro.props;
const dist = computeDistribution(song);
const active = dist.members.filter((m) => m.lines > 0);
---
<section aria-labelledby="dist-heading" class="card p-4 sm:p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="dist-heading" class="text-base font-bold">Line distribution</h2>
    <p class="text-xs text-ink-faint">Sắp xếp giảm dần theo số dòng</p>
  </div>

  <!-- Thanh stacked (horizontal) — không dùng pie chart trên mobile -->
  <div
    class="mt-4 flex h-5 w-full overflow-hidden rounded-full bg-white/10 ring-1 ring-white/10"
    role="img"
    aria-label={`Tỷ lệ dòng theo thành viên: ${active.map((m) => `${m.name} ${m.percent}%`).join(', ') || 'chưa có dữ liệu'}`}
  >
    {
      active.map((m) => (
        <div
          class="stacked-segment h-full"
          style={`width: ${m.percent}%; background: ${m.color}`}
          title={`${m.name}: ${m.lines} dòng (${m.percent}%)`}
        />
      ))
    }
  </div>

  <ul class="mt-4 flex flex-col gap-2.5">
    {
      dist.members.map((m) => (
        <li class="grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-1 sm:grid-cols-[minmax(7rem,10rem)_1fr_auto]">
          <span
            class="chip max-w-full truncate text-xs"
            style={`border-color: ${m.color}55; background: ${m.color}18; color: ${m.color}`}
          >
            <span class="h-2 w-2 shrink-0 rounded-full" style={`background: ${m.color}`} aria-hidden="true" />
            <span class="truncate">{m.name}</span>
          </span>
          <span class="h-2.5 w-full overflow-hidden rounded-full bg-white/10" aria-hidden="true">
            <span
              class="block h-full rounded-full"
              style={`width: ${m.percent}%; background: ${m.color}`}
            />
          </span>
          <span class="whitespace-nowrap text-right text-xs font-semibold tabular-nums">
            <span class="text-ink">{m.lines}</span>
            <span class="text-ink-faint"> dòng · </span>
            <span class="text-ink-muted">{m.percent}%</span>
          </span>
        </li>
      ))
    }
  </ul>

  <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-white/10 pt-4 text-xs sm:grid-cols-4">
    <div>
      <dt class="text-ink-faint">Tổng dòng (không adlib)</dt>
      <dd class="mt-0.5 text-sm font-bold tabular-nums">{dist.totalLines}</dd>
    </div>
    <div>
      <dt class="text-ink-faint">Dòng gán thành viên</dt>
      <dd class="mt-0.5 text-sm font-bold tabular-nums">{dist.totalMemberLines}</dd>
    </div>
    <div>
      <dt class="text-ink-faint">Dòng All/ensemble</dt>
      <dd class="mt-0.5 text-sm font-bold tabular-nums">{dist.ensembleLines}</dd>
    </div>
    <div>
      <dt class="text-ink-faint">Adlib (không tính)</dt>
      <dd class="mt-0.5 text-sm font-bold tabular-nums">{dist.adlibLines}</dd>
    </div>
  </dl>
  <p class="mt-3 text-[11px] leading-relaxed text-ink-faint">
    Một dòng có nhiều thành viên được tính 1 dòng cho từng thành viên. Dòng adlib không được tính vào
    line distribution. Numbers mang tính thống kê nội dung, không để so sánh cạnh tranh giữa các thành viên.
  </p>
</section>
