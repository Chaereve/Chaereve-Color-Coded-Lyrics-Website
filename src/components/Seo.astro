---
/**
 * <Seo> — dynamic title/description, canonical, Open Graph, Twitter Card and
 * JSON-LD. Pass `path` (site-relative, e.g. "/lyrics/ive/crumbs/") and optional
 * `image` (site-relative) plus any number of `jsonLd` objects.
 */
import { absoluteUrl, compactJsonLd } from '../lib/seo';
import { getSite } from '../lib/content';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noIndex?: boolean;
}

const { title, description, path, image, type = 'website', jsonLd = [], noIndex = false } = Astro.props;
const site = new URL(Astro.site ?? 'http://localhost:4321');
const settings = getSite().settings;
const pageTitle = `${title} · ${settings.name}`;
const url = absoluteUrl(path, site);
const ogImage = image ? absoluteUrl(image, site) : absoluteUrl(settings.ogImage, site);
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noIndex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={url} />

<meta property="og:site_name" content={settings.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={settings.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((data) => {
  const clean = compactJsonLd(data);
  if (!clean) return '';
  return <script type="application/ld+json" set:html={JSON.stringify(clean)} />;
})}
