---
interface Props {
  title: string;
  hint?: string;
}
const { title, hint } = Astro.props;
---
<div class="card flex flex-col items-center gap-3 px-6 py-12 text-center">
  <svg
    aria-hidden="true"
    width="40"
    height="40"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="text-ink-faint"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path><path
      d="M8.5 11h5"></path></svg
  >
  <p class="text-sm font-semibold">{title}</p>
  {hint && <p class="max-w-sm text-xs text-ink-muted">{hint}</p>}
  <slot />
</div>
