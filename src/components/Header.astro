---
import { categoryUrl, getSite } from '../lib/content';

const { settings, categories } = getSite();

const navPages = [
  { href: '/lyrics/', label: 'Lyrics' },
  { href: '/artists/', label: 'Artists' },
  { href: '/translations/', label: 'Translations' },
  { href: '/corrections/', label: 'Corrections' },
  { href: '/authors/', label: 'Authors' },
];

/* CCL-style order: KOREAN first, the rest alphabetical. */
const priority: Record<string, number> = { korean: 0 };
const orderedCategories = [...categories].sort(
  (a, b) => (priority[a.id] ?? 1) - (priority[b.id] ?? 1) || a.name.localeCompare(b.name),
);
---

<header class="site-header">
  <div class="container-site">
    <div class="site-brand">
      <a href="/" class="site-title" aria-label={`${settings.name} — home`}>{settings.name}</a>
      <p class="site-tagline">{settings.tagline}</p>
    </div>
  </div>

  <nav class="main-nav" aria-label="Main">
    <ul>
      {orderedCategories.map((c, i) => (
        <>
          {i > 0 && <li class="nav-sep" aria-hidden="true"></li>}
          <li>
            <a
              href={categoryUrl(c)}
              aria-current={Astro.url.pathname === categoryUrl(c) ? 'page' : undefined}
            >{c.name}</a>
          </li>
        </>
      ))}
      <li class="nav-sep" aria-hidden="true"></li>
      {navPages.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
          >{item.label}</a>
        </li>
      ))}
      <li>
        <form class="site-search" action="/search/" method="get" role="search" aria-label="Site search">
          <label class="sr-only" for="site-search">Search lyrics, artists, members</label>
          <input id="site-search" name="q" type="search" placeholder="Search" autocomplete="off" />
          <button type="submit">Search</button>
        </form>
      </li>
    </ul>
  </nav>
</header>
