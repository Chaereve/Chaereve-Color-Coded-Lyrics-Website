---
/** CCL-style archive list: full-width cards + WordPress-style pagination. */
import type { Page } from '../lib/paginate';
import type { Song } from '../lib/types';
import SongCard from './SongCard.astro';
import Pagination from './Pagination.astro';

interface Props {
  /** All visible songs, newest first. */
  all: Song[];
  /** The current page (page.items is what gets rendered). */
  page: Page<Song>;
  perPage: number;
  /** Where page 1 lives (default /lyrics/). */
  firstUrl?: string;
}

const { all, page, perPage, firstUrl = '/lyrics/' } = Astro.props;
const pages = Math.max(1, Math.ceil(all.length / perPage));
const base = firstUrl.replace(/\/$/, '');
const adjusted: Page<Song> = {
  ...page,
  url: page.page <= 1 ? `${base}/` : `${base}/page/${page.page}/`,
  firstUrl: `${base}/`,
  prevUrl: page.page <= 1 ? undefined : page.page === 2 ? `${base}/` : `${base}/page/${page.page - 1}/`,
  nextUrl: page.page >= pages ? undefined : `${base}/page/${page.page + 1}/`,
};
---

<ul class="post-list">
  {page.items.map((song) => (
    <li><SongCard song={song} variant="archive" /></li>
  ))}
</ul>
{page.items.length === 0 && <p class="meta mt-4">No songs here yet.</p>}
<Pagination page={adjusted} label="lyrics" />
