---
import type { Artist, Song } from '../lib/types';
import { formatDate } from '../lib/format';

interface Props {
  song: Song;
  artist?: Artist;
}
const { song, artist } = Astro.props;
const colorDots = (song.members ?? []).slice(0, 6);
---
<a
  href={`/lyrics/${song.slug}/`}
  class="card group flex flex-col overflow-hidden transition-transform hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-2"
>
  <div class="relative aspect-square w-full overflow-hidden bg-surface-muted">
    <img
      src={song.cover || '/uploads/placeholder-cover.svg'}
      alt={`Bìa bài ${song.title}`}
      width="400"
      height="400"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-3">
      <div class="flex flex-wrap gap-1">
        {
          colorDots.map((m) => (
            <span
              class="h-2.5 w-2.5 rounded-full ring-1 ring-black/30"
              style={`background: ${m.color}`}
              title={m.name}
            />
          ))
        }
      </div>
    </div>
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h3 class="line-clamp-2 text-sm font-bold leading-snug group-hover:text-accent-soft">{song.title}</h3>
    <p class="text-xs text-ink-muted">{artist?.name ?? song.artistId}</p>
    <div class="mt-auto flex items-center justify-between pt-2 text-[11px] text-ink-faint">
      <time datetime={song.released}>{formatDate(song.released)}</time>
      {song.album && <span class="truncate pl-2">{song.album}</span>}
    </div>
  </div>
</a>
