---
import type { Artist, Song } from '../lib/types';
import { formatDate } from '../lib/format';

interface Props {
  song: Song;
  artist?: Artist;
}
const { song, artist } = Astro.props;
---
<a href={`/lyrics/${song.slug}/`} class="group block focus-visible:outline-2">
  <div class="relative aspect-square w-full overflow-hidden rounded-lg bg-surface-muted">
    <img
      src={song.cover || '/uploads/placeholder-cover.svg'}
      alt={`Bìa bài ${song.title}`}
      width="400"
      height="400"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </div>
  <div class="mt-2.5 min-w-0">
    <h3 class="line-clamp-2 text-sm font-semibold leading-snug group-hover:text-link">{song.title}</h3>
    <p class="mt-0.5 truncate text-xs text-ink-muted">
      {artist?.name ?? song.artistId}{song.released ? ` · ${formatDate(song.released)}` : ''}
    </p>
    <div class="mt-1.5 flex gap-1" aria-hidden="true">
      {
        (song.members ?? []).slice(0, 6).map((m) => (
          <span class="h-1.5 w-1.5 rounded-full" style={`background: ${m.color}`} />
        ))
      }
    </div>
  </div>
</a>
