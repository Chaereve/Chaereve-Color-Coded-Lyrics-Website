---
import { artistUrl, categoryUrl, getSite, pageUrl } from '../lib/content';

const { settings, categories, artists, pages } = getSite();
const footerPages = pages.filter((p) => p.inFooter);
const topArtists = [...artists].slice(0, 6);
---

<footer class="site-footer">
  <div class="container-site">
    <div class="footer-cols">
      <nav aria-label="Browse">
        <h2>Browse</h2>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/lyrics/">All lyrics</a></li>
          <li><a href="/artists/">Artists (A–Z)</a></li>
          <li><a href="/members/">Members</a></li>
          <li><a href="/search/">Search</a></li>
        </ul>
      </nav>

      <nav aria-label="Categories">
        <h2>Categories</h2>
        <ul>
          {categories.map((c) => (
            <li><a href={categoryUrl(c)}>{c.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Popular artists">
        <h2>Popular artists</h2>
        <ul>
          {topArtists.map((a) => (
            <li><a href={artistUrl(a)}>{a.name}{a.nativeName ? ` (${a.nativeName})` : ''}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Site">
        <h2>Site</h2>
        <ul>
          <li><a href="/translations/">Translations</a></li>
          <li><a href="/corrections/">Corrections</a></li>
          <li><a href="/authors/">Contributors</a></li>
          {footerPages.map((p) => (
            <li><a href={pageUrl(p)}>{p.title}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>
        <time datetime={new Date().toISOString().slice(0, 4)}>{new Date().getFullYear()}</time> {settings.name} — fan project, no affiliation with any artist, group or label.
      </p>
      <p>
        {settings.name} does not authorize any usage of our work (including, but not limited to: transliterations, translations, codings, etc.) in monetized media.
      </p>
      {settings.footerNote && <p>{settings.footerNote}</p>}
    </div>
  </div>
</footer>
