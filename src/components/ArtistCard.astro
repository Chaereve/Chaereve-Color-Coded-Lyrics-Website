---
import { artistUrl, getSongsByArtist } from '../lib/content';
import { pluralize } from '../lib/text';
import type { Artist } from '../lib/types';

interface Props {
  artist: Artist;
}

const { artist } = Astro.props;
const songs = getSongsByArtist(artist.id);
---

<a class="artist-card" href={artistUrl(artist)}>
  {artist.cover ? (
    <img
      src={artist.cover}
      alt={`Cover of ${artist.name}`}
      loading="lazy"
      width="300"
      height="300"
    />
  ) : (
    <span class="artist-card-fallback flex aspect-square items-center justify-center text-3xl font-bold" style="color:var(--muted)" aria-hidden="true">
      {artist.name.charAt(0)}
    </span>
  )}
  <h3>
    <a href={artistUrl(artist)}>{artist.name}{artist.nativeName ? ` (${artist.nativeName})` : ''}</a>
  </h3>
  <p class="meta capitalize">
    {artist.type} · {pluralize(artist.members.length, 'member')} · {pluralize(songs.length, 'song')}
  </p>
</a>
