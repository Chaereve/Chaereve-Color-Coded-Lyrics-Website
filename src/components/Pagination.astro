---
/** WordPress-style pagination: "‹ Newer posts" / "Older posts ›". */
import type { Page } from '../lib/paginate';

interface Props {
  page: Page<unknown>;
  /** Accessible label, e.g. "lyrics pages". */
  label?: string;
}

const { page, label = 'pages' } = Astro.props;
if (page.totalPages <= 1) return;
---

<nav class="post-nav" aria-label={`Pagination (${label})`}>
  {page.prevUrl ? (
    <a href={page.prevUrl} rel="prev"><span aria-hidden="true">‹</span> Newer posts</a>
  ) : (
    <span aria-hidden="true"><span aria-hidden="true">‹</span> Newer posts</span>
  )}
  <span class="post-nav-mid">Page {page.page} of {page.totalPages}</span>
  {page.nextUrl ? (
    <a href={page.nextUrl} rel="next">Older posts <span aria-hidden="true">›</span></a>
  ) : (
    <span>Older posts <span aria-hidden="true">›</span></span>
  )}
</nav>
