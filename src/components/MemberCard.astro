---
interface Props {
  name: string;
  color: string;
  subtitle?: string;
  href: string;
  lines?: number;
}
const { name, color, subtitle, href, lines } = Astro.props;
---
<a href={href} class="card flex items-center gap-3 p-4 transition-transform hover:-translate-y-0.5">
  <span
    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-sm font-black text-white shadow-inner"
    style={`background: ${color}`}
    aria-hidden="true">{name.charAt(0).toUpperCase()}</span
  >
  <span class="min-w-0 flex-1">
    <span class="block truncate text-sm font-bold group-hover:text-link">{name}</span>
    {subtitle && <span class="block truncate text-xs text-ink-muted">{subtitle}</span>}
  </span>
  {
    typeof lines === 'number' && (
      <span class="shrink-0 rounded-lg bg-black/[0.04] dark:bg-white/5 px-2 py-1 text-xs font-semibold text-ink-muted">
        {lines} dòng
      </span>
    )
  }
</a>
