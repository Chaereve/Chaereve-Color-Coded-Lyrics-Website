---
/**
 * Nút bật/tắt dark–light mode.
 * Dark là mặc định; lựa chọn lưu vào localStorage ('theme').
 */
---
<button
  type="button"
  id="theme-toggle"
  class="btn-ghost relative h-11 w-11 !min-w-11 rounded-full !px-0"
  aria-label="Chế độ sáng/tối"
  title="Chế độ sáng/tối"
>
  <svg
    class="dark:hidden"
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path></svg
  >
  <svg
    class="hidden dark:block"
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    ><circle cx="12" cy="12" r="4"></circle><path
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4l1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4l1.4-1.4"></path></svg
  >
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('#theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const nextDark = !root.classList.contains('dark');
    root.classList.toggle('dark', nextDark);
    try {
      localStorage.setItem('theme', nextDark ? 'dark' : 'light');
    } catch {
      /* localStorage bị chặn — bỏ qua */
    }
  });
</script>
