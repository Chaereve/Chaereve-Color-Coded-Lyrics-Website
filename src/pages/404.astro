---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArtists, getPublishedSongs } from '../lib/content';

const songs = getPublishedSongs();
const suggestions = songs.slice(0, 8).map((s) => ({
  title: s.title,
  href: `/lyrics/${s.slug}/`,
  artist: getArtists().find((a) => a.id === s.artistId)?.name ?? '',
  cover: s.cover ?? '/uploads/placeholder-cover.svg',
}));
---
<BaseLayout title="Không tìm thấy trang" description="Trang bạn tìm không tồn tại." path="/404/" noindex>
  <div class="container-page flex flex-col items-center px-4 py-16 text-center">
    <p class="text-7xl font-black tracking-tight text-accent-soft" aria-hidden="true">404</p>
    <h1 class="mt-3 text-xl font-bold sm:text-2xl">Trang này không tồn tại</h1>
    <p class="mt-2 max-w-md text-sm text-ink-muted">
      Có thể đường dẫn đã đổi hoặc bài hát chưa được publish. Thử tìm kiếm hoặc quay về trang chủ.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Về trang chủ</a>
      <a href="/search/" class="btn-ghost">Tìm kiếm</a>
    </div>

    {
      suggestions.length > 0 && (
        <section aria-labelledby="random-heading" class="mt-12 w-full max-w-2xl text-left">
          <h2 id="random-heading" class="mb-3 text-sm font-bold uppercase tracking-wide text-ink-faint">
            Gợi ý bài hát
          </h2>
          <ul id="random-songs" class="grid gap-2 sm:grid-cols-2" data-songs={JSON.stringify(suggestions)}>
            {suggestions.slice(0, 4).map((s) => (
              <li>
                <a href={s.href} class="card flex items-center gap-3 p-3 hover:-translate-y-0.5 transition-transform">
                  <img
                    src={s.cover}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-12 rounded-lg object-cover"
                  />
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-bold">{s.title}</span>
                    <span class="block truncate text-xs text-ink-muted">{s.artist}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  // Chọn 3 bài ngẫu nhiên để gợi ý
  const list = document.getElementById('random-songs');
  if (list) {
    try {
      const songs = JSON.parse(list.dataset.songs ?? '[]') as { title: string; href: string; artist: string; cover: string }[];
      if (songs.length > 3) {
        const picked = [...songs].sort(() => Math.random() - 0.5).slice(0, 3);
        list.innerHTML = picked
          .map(
            (s) => `
          <li>
            <a href="${s.href}" class="card flex items-center gap-3 p-3 transition-transform hover:-translate-y-0.5">
              <img src="${s.cover}" alt="" width="48" height="48" loading="lazy" decoding="async" class="h-12 w-12 rounded-lg object-cover" />
              <span class="min-w-0">
                <span class="block truncate text-sm font-bold">${s.title}</span>
                <span class="block truncate text-xs text-ink-muted">${s.artist}</span>
              </span>
            </a>
          </li>`,
          )
          .join('');
      }
    } catch {
      /* giữ nguyên danh sách mặc định */
    }
  }
</script>
