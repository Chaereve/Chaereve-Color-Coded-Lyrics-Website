---
import BaseLayout from '../layouts/BaseLayout.astro';
import Seo from '../components/Seo.astro';
import { getSite } from '../lib/content';

const settings = getSite().settings;
---

<BaseLayout>
  <Seo title="Page not found" description="This page does not exist (or has been moved)." path="/404/" noIndex />
  <div class="container-site flex flex-col items-start py-16">
    <p class="meta">Error 404</p>
    <h1>This page went missing</h1>
    <p class="max-w-prose text-[0.9375rem] text-muted">
      The link may be outdated, or the content was moved during a review. Try the search, or head back to the
      {settings.name} homepage.
    </p>
    <form action="/search/" method="get" class="mt-6 flex w-full max-w-md gap-2" role="search" aria-label="Search">
      <label class="sr-only" for="nf-search">Search</label>
      <input class="input flex-1" id="nf-search" name="q" type="search" placeholder="Search a song, artist or lyric…" />
      <button class="btn btn-primary" type="submit">Search</button>
    </form>
    <p class="mt-6 flex flex-wrap gap-3">
      <a class="btn" href="/">Home</a>
      <a class="btn" href="/lyrics/">Lyrics archive</a>
      <a class="btn" href="/artists/">Artists</a>
    </p>
  </div>
</BaseLayout>
