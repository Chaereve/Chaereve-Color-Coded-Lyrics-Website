---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import MemberChip from '../components/MemberChip.astro';
import { getArtists, getPublishedSongs } from '../lib/content';
import { computeDistribution, memberLinesAcrossSongs } from '../lib/distribution';
import { SITE_NAME, SITE_TAGLINE } from '../lib/config';
import { formatDate } from '../lib/format';

const artists = getArtists();
const songs = getPublishedSongs();

const latest = songs.slice(0, 6);
const trending = [...songs]
  .map((s) => ({ song: s, lines: computeDistribution(s).totalLines }))
  .sort((a, b) => b.lines - a.lines)
  .slice(0, 3);

const artistRows = artists
  .map((a) => ({ artist: a, count: songs.filter((s) => s.artistId === a.id).length }))
  .sort((a, b) => b.count - a.count);

const memberSpotlight = artists
  .flatMap((a) => (a.members ?? []).map((m) => ({ member: m, artist: a })))
  .map((x) => ({ ...x, lines: memberLinesAcrossSongs(x.member.id, songs) }))
  .sort((a, b) => b.lines - a.lines)
  .slice(0, 6);

// Dải màu thành viên — “chữ ký” visual của site, lấy từ dữ liệu chứ không phải gradient trang trí
const colorStrip = artists.flatMap((a) => (a.members ?? []).map((m) => m.color));
const totalMembers = artists.reduce((n, a) => n + (a.members?.length ?? 0), 0);
---
<BaseLayout path="/">
  <!-- Hero: editorial, phẳng, không gradient -->
  <section class="border-b border-black/10 bg-surface-raised dark:border-white/10">
    <div class="container-page pb-10 pt-10 sm:pb-12 sm:pt-14">
      <p class="kicker text-link">Color-coded lyrics · Line distribution</p>
      <h1 class="mt-3 text-[2.75rem] font-black leading-[1.02] tracking-[-0.035em] sm:text-6xl">
        {SITE_NAME}
      </h1>
      <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-ink-muted">
        {SITE_TAGLINE} — lyrics tô màu theo từng thành viên, line distribution minh bạch,
        romanization & translation. Dữ liệu lưu trong Git, có credits và quy trình correction.
      </p>
      <div class="mt-6 max-w-xl">
        <SearchBar large />
      </div>
      <p class="mt-5 text-xs text-ink-faint">
        <strong class="font-bold text-ink-muted">{songs.length}</strong> bài hát ·
        <strong class="font-bold text-ink-muted">{artists.length}</strong> nghệ sĩ ·
        <strong class="font-bold text-ink-muted">{totalMembers}</strong> thành viên
      </p>
    </div>
    <div class="flex h-1.5 w-full" aria-hidden="true">
      {colorStrip.map((c) => <span class="flex-1" style={`background: ${c}`}></span>)}
    </div>
  </section>

  <div class="container-page flex flex-col gap-12 py-10 sm:py-12">
    <!-- Bài hát mới nhất — tracklist dạng hàng (kiểu Genius/Spotify) -->
    <section aria-labelledby="latest-heading">
      <div class="mb-4 flex items-baseline justify-between gap-3">
        <div>
          <p class="kicker">Mới phát hành</p>
          <h2 id="latest-heading" class="section-title mt-1">Bài hát mới nhất</h2>
        </div>
        <a href="/search/" class="see-all shrink-0">Xem tất cả →</a>
      </div>
      <ol class="card overflow-hidden divide-y divide-black/[0.07] dark:divide-white/[0.07]">
        {
          latest.map((song, i) => (
            <li>
              <a
                href={`/lyrics/${song.slug}/`}
                class="group flex items-center gap-3 px-3 py-2.5 transition-colors hover:bg-black/[0.03] sm:gap-4 sm:px-4 dark:hover:bg-white/[0.04]"
              >
                <span class="w-5 shrink-0 text-center text-xs font-bold tabular-nums text-ink-faint group-hover:text-link">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <img
                  src={song.cover || '/uploads/placeholder-cover.svg'}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  class="h-11 w-11 shrink-0 rounded object-cover"
                />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-semibold group-hover:text-link">{song.title}</span>
                  <span class="block truncate text-xs text-ink-muted">
                    {artists.find((a) => a.id === song.artistId)?.name ?? song.artistId}
                    {song.released ? ` · ${formatDate(song.released)}` : ''}
                  </span>
                </span>
                <span class="hidden shrink-0 gap-1 sm:flex" aria-hidden="true">
                  {(song.members ?? []).slice(0, 6).map((m) => (
                    <span class="h-2 w-2 rounded-full" style={`background: ${m.color}`} />
                  ))}
                </span>
                <svg
                  aria-hidden="true"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="shrink-0 text-ink-faint group-hover:text-link"
                >
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Trending — thẻ ảnh tối giản -->
    {
      trending.length > 0 && (
        <section aria-labelledby="trending-heading">
          <div class="mb-4">
            <p class="kicker">Nổi bật</p>
            <h2 id="trending-heading" class="section-title mt-1">Trending</h2>
            <p class="mt-1 text-xs text-ink-faint">Bài có nhiều dòng lời nhất — không dùng dữ liệu ẩn danh</p>
          </div>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5">
            {trending.map(({ song, lines }) => (
              <a href={`/lyrics/${song.slug}/`} class="group block">
                <div class="relative aspect-square overflow-hidden rounded-lg bg-surface-muted">
                  <img
                    src={song.cover || '/uploads/placeholder-cover.svg'}
                    alt={`Bìa bài ${song.title}`}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  />
                </div>
                <div class="mt-2.5 min-w-0">
                  <h3 class="truncate text-sm font-semibold group-hover:text-link">{song.title}</h3>
                  <p class="truncate text-xs text-ink-muted">
                    {artists.find((a) => a.id === song.artistId)?.name ?? song.artistId}
                  </p>
                  <p class="mt-1 text-xs font-semibold tabular-nums text-ink-faint">{lines} dòng lời</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- Nghệ sĩ -->
    <section aria-labelledby="artists-heading">
      <div class="mb-4">
        <p class="kicker">Nghệ sĩ</p>
        <h2 id="artists-heading" class="section-title mt-1">Khám phá theo nghệ sĩ</h2>
      </div>
      <ul class="card divide-y divide-black/[0.07] dark:divide-white/[0.07]">
        {
          artistRows.map(({ artist, count }) => (
            <li>
              <a
                href={`/artist/${artist.slug}/`}
                class="group flex items-center gap-4 px-4 py-3.5 transition-colors hover:bg-black/[0.03] dark:hover:bg-white/[0.04]"
              >
                <img
                  src={artist.cover || '/uploads/placeholder-cover.svg'}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  decoding="async"
                  class="h-14 w-14 shrink-0 rounded-lg object-cover"
                />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-bold group-hover:text-link">{artist.name}</span>
                  <span class="block truncate text-xs text-ink-muted">
                    {artist.type === 'group' ? 'Nhóm' : 'Solo'} · {count} bài · {artist.members?.length ?? 0} thành viên
                  </span>
                </span>
                <span class="hidden shrink-0 flex-wrap justify-end gap-1.5 sm:flex">
                  {(artist.members ?? []).slice(0, 6).map((m) => (
                    <MemberChip name={m.name} color={m.color} />
                  ))}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Thành viên nổi bật -->
    <section aria-labelledby="members-heading">
      <div class="mb-4">
        <p class="kicker">Thành viên</p>
        <h2 id="members-heading" class="section-title mt-1">Thành viên nổi bật</h2>
        <p class="mt-1 text-xs text-ink-faint">
          Theo tổng số dòng trên toàn site — để tra cứu nội dung, không so sánh cạnh tranh
        </p>
      </div>
      <ul class="grid gap-2 sm:grid-cols-2">
        {
          memberSpotlight.map(({ member, artist, lines }) => (
            <li>
              <a
                href={`/member/${member.id}/`}
                class="card group flex items-center gap-3 px-4 py-3 transition-colors hover:bg-black/[0.03] dark:hover:bg-white/[0.04]"
              >
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-black text-black"
                  style={`background: ${member.color}`}
                  aria-hidden="true"
                >
                  {member.name.charAt(0).toUpperCase()}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-semibold group-hover:text-link">{member.name}</span>
                  <span class="block truncate text-xs text-ink-muted">{artist.name}</span>
                </span>
                <span class="shrink-0 text-xs font-bold tabular-nums text-ink-faint">{lines} dòng</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
