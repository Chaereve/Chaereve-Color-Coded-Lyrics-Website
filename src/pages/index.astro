---
import BaseLayout from '../layouts/BaseLayout.astro';
import Seo from '../components/Seo.astro';
import SongCard from '../components/SongCard.astro';
import { getLatestSongs, getSite, getTrendingSongs } from '../lib/content';
import { truncate } from '../lib/text';
import { websiteJsonLd } from '../lib/seo';

const site = new URL(Astro.site ?? 'http://localhost:4321');
const { settings } = getSite();

const trending = getTrendingSongs(7);
const latest = getLatestSongs(12);
const description = truncate(settings.description, 160);
---

<BaseLayout>
  <Seo
    title={settings.tagline}
    description={description}
    path="/"
    jsonLd={[websiteJsonLd(settings.name, description, site)]}
  />

  <div class="container-site">
    {/* ---------------- Trending Songs ---------------- */}
    <section aria-labelledby="trending-title">
      <h1 id="trending-title" class="page-head mt-8">
        <span>Trending Songs</span>
      </h1>
      <div class="trend-grid">
        {trending.map((song) => <SongCard song={song} variant="trend" />)}
      </div>
      {trending.length === 0 && (
        <p class="meta mt-4">No published songs yet — check back soon.</p>
      )}
    </section>

    {/* ---------------- Latest ---------------- */}
    <section class="mt-14" aria-labelledby="latest-title">
      <h2 id="latest-title" class="page-head">
        <span>Latest Songs</span>
        <a class="cl text-[0.8125rem]" href="/lyrics/">All lyrics →</a>
      </h2>
      <div class="latest-grid">
        {latest.map((song) => <SongCard song={song} variant="latest" />)}
      </div>
      {latest.length === 0 && (
        <p class="meta mt-4">Nothing here yet.</p>
      )}
    </section>
  </div>
</BaseLayout>
