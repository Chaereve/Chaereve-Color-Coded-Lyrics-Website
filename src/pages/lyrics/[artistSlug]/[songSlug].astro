---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommunityForm from '../../../components/CommunityForm.astro';
import LineDistribution from '../../../components/LineDistribution.astro';
import Lyrics from '../../../components/Lyrics.astro';
import Seo from '../../../components/Seo.astro';
import SongCard from '../../../components/SongCard.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import {
  artistUrl,
  categoryUrl,
  getAdjacentSongs,
  getApprovedComments,
  getArtist,
  getCategory,
  getRelatedSongs,
  getSite,
  getSongsByArtist,
  songUrl,
} from '../../../lib/content';
import { memberColorValue } from '../../../lib/lyrics';
import { formatDate, formatDateISO, truncate, yearOf } from '../../../lib/text';
import { musicRecordingJsonLd } from '../../../lib/seo';
import type { GetStaticPaths } from 'astro';
import type { Artist, Song } from '../../../lib/types';

export const getStaticPaths: GetStaticPaths = async () => {
  const { songs } = getSite();
  return songs
    .filter((s) => getArtist(s.artistId))
    .map((song) => {
      const artist = getArtist(song.artistId)!;
      return { params: { artistSlug: artist.slug, songSlug: song.slug }, props: { song, artist } };
    });
};

const { song, artist } = Astro.props as { song: Song; artist: Artist };
const site = new URL(Astro.site ?? 'http://localhost:4321');
const cats = song.categories.map((id) => getCategory(id)).filter((c) => c !== undefined);
const adjacent = getAdjacentSongs(song);
const similar = getRelatedSongs(song, 2);
const byArtist = getSongsByArtist(artist.id).filter((s) => s.id !== song.id).slice(0, 6);
const comments = getApprovedComments(song.id);
const versions = [
  { id: 'main', name: 'Main version (studio coding)' },
  ...song.versions.map((v) => ({ id: v.id, name: `${v.name}${v.audioType !== 'studio' ? ` · ${v.audioType}` : ''}` })),
];
const description = truncate(
  `Color-coded lyrics for “${song.title}” by ${artist.name}. ${song.album ? `${song.album}, ` : ''}${formatDateISO(song.released)} — romanization, translation and line distribution.`,
  160,
);
const artistHead = artist.nativeName ? `${artist.name} (${artist.nativeName})` : artist.name;
---

<BaseLayout>
  <Seo
    title={`${artist.name} - ${song.title} Lyrics`}
    description={description}
    path={songUrl(song, artist)}
    image={song.cover}
    jsonLd={[musicRecordingJsonLd(song, artist, songUrl(song, artist), site)]}
  />

  <article class="container-post post" data-song-root>
    {/* ---------------- category links + title block (CCL header) ---------------- */}
    <p class="post-cats">
      {cats.map((c) => (
        <a href={categoryUrl(c)}>{c.name}</a>
      ))}
      <a href={artistUrl(artist)}>{artistHead}</a>
    </p>

    <h1 class="post-title">
      {song.title}
      {song.status !== 'published' && <StatusBadge status={song.status} />}
    </h1>
    {song.nativeTitle && song.nativeTitle !== song.title && (
      <p class="post-title-sub">{song.nativeTitle}</p>
    )}
    {song.album && (
      <p class="post-album">{song.album}</p>
    )}
    <p class="post-date">{formatDateISO(song.released)}</p>

    <hr class="post-hr" />

    {/* ---------------- songwriting credits ---------------- */}
    <div class="credits-block">
      {song.credits.lyrics.length > 0 && (
        <p><span class="credits-label">Lyrics/작사</span>: {song.credits.lyrics.join(', ')}</p>
      )}
      {song.credits.composition.length > 0 && (
        <p><span class="credits-label">Composer/작곡</span>: {song.credits.composition.join(', ')}</p>
      )}
      {song.credits.arrangement.length > 0 && (
        <p><span class="credits-label">Arranger/편곡</span>: {song.credits.arrangement.join(', ')}</p>
      )}
    </div>

    {versions.length > 1 && (
      <p class="version-switch">
        <label class="sr-only" for="version-select">Version</label>
        <select id="version-select" data-version-select>
          {versions.map((v) => (
            <option value={v.id}>{v.name}</option>
          ))}
        </select>
      </p>
    )}

    {/* ---------------- cover + member names ---------------- */}
    <figure class="cover-wrap">
      {song.cover ? (
        <img src={song.cover} alt={`Cover of ${song.title} by ${artist.name}`} width="320" height="320" />
      ) : (
        <span class="cover-fallback flex aspect-square items-center justify-center text-5xl font-bold" style="color:var(--muted)" aria-hidden="true">
          {song.title.charAt(0)}
        </span>
      )}
      <figcaption class="singer-names">
        {song.members.map((m, i) => (
          <>
            <span style={`color:${memberColorValue(m.id)}`}>{m.name}</span>
            {i < song.members.length - 1 ? ', ' : ''}
          </>
        ))}
      </figcaption>
    </figure>

    <hr class="post-hr" />

    {/* ---------------- lyrics: Romanization / Hangul / Translation ---------------- */}
    <div data-version-block data-version-id="main">
      <Lyrics song={song} block="romanization" />
      <hr class="post-hr" />
      <Lyrics song={song} block="original" />
      <hr class="post-hr" />
      <Lyrics song={song} block="translation" />
    </div>

    {song.versions.map((version) => (
        <div data-version-block data-version-id={version.id} hidden>
          <p class="meta mb-4 text-center">
            {version.name}
            {(version.notes ?? []).length > 0 && <span> — {version.notes?.join(' · ')}</span>}
          </p>
          <Lyrics song={song} version={version} block="romanization" />
          <hr class="post-hr" />
          <Lyrics song={song} version={version} block="original" />
          <hr class="post-hr" />
          <Lyrics song={song} version={version} block="translation" />
        </div>
    ))}

    <hr class="post-hr" />

    {/* ---------------- source credits (CCL "Credits") ---------------- */}
    <div class="credits-block" style="margin-bottom:0">
      <p><span class="credits-label">Credits</span></p>
      {song.credits.source && <p>Korean: {song.credits.source}</p>}
      {song.credits.romanization.length > 0 && <p>Rom: {song.credits.romanization.join(', ')}</p>}
      {song.credits.translation.length > 0 && <p>Eng: {song.credits.translation.join(', ')}</p>}
      {song.sources.length > 0 && (
        <p>Info: {song.sources.join(' · ')}</p>
      )}
    </div>

    {/* ---------------- line distribution (expandable) ---------------- */}
    <details class="post-details">
      <summary>Line distribution</summary>
      <div class="post-details-body" data-version-distribution="main">
        <LineDistribution members={song.members} sections={song.sections} />
        <p class="hint">Color coding basis: studio audio. Adlibs are excluded by default — press “Adlibs” below to include them.</p>
        {song.versions.map((version) => (
          <div class="mt-4" data-version-distribution={version.id} hidden>
            <LineDistribution members={version.members ?? song.members} sections={version.sections} />
          </div>
        ))}
      </div>
    </details>

    {/* ---------------- controls ---------------- */}
    <div class="lyrics-controls">
      <button class="btn btn-sm" type="button" data-toggle="names" aria-pressed="true">Names</button>
      <button class="btn btn-sm" type="button" data-toggle="adlibs" aria-pressed="false">Adlibs</button>
      <span class="ctrl-sep" aria-hidden="true"></span>
      <button class="btn btn-sm" type="button" data-fontsize="sm" aria-pressed="false" aria-label="Small lyrics font">A−</button>
      <button class="btn btn-sm" type="button" data-fontsize="md" aria-pressed="true" aria-label="Medium lyrics font">A</button>
      <button class="btn btn-sm" type="button" data-fontsize="lg" aria-pressed="false" aria-label="Large lyrics font">A+</button>
      <span class="ctrl-sep" aria-hidden="true"></span>
      <button class="btn btn-sm" type="button" data-copy>Copy lyrics</button>
      {song.youtube && (
        <a class="btn btn-sm" href={song.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
      )}
    </div>

    <hr class="post-hr" />

    {/* ---------------- more songs by artist ---------------- */}
    {byArtist.length > 0 && (
      <section aria-labelledby="more-songs-title">
        <h3 id="more-songs-title" class="post-subhead">More songs by {artistHead}</h3>
        <ul class="more-songs">
          {byArtist.map((s) => (
            <li>
              <a href={songUrl(s, artist)}>{artistHead} – {s.title}</a>
            </li>
          ))}
        </ul>
        <p class="mt-2">
          <a class="cl" href={artistUrl(artist)}>All {artist.name} lyrics →</a>
        </p>
      </section>
    )}

    {/* ---------------- similar posts ---------------- */}
    {similar.length > 0 && (
      <section aria-labelledby="similar-title">
        <h3 id="similar-title" class="post-subhead">Similar Posts</h3>
        <div class="similar-grid">
          {similar.map((s) => (
            <SongCard song={s} variant="latest" />
          ))}
        </div>
      </section>
    )}

    <hr class="post-hr" />

    {/* ---------------- comments (CCL "Leave a Reply") ---------------- */}
    <section aria-labelledby="comments-title">
      <h3 id="comments-title" class="post-subhead">Comments ({comments.length})</h3>
      {comments.length > 0 ? (
        <ul class="comments-list">
          {comments.map((cm) => (
            <li class="comment">
              <p class="comment-head">
                <span class="comment-name">{cm.name}</span>
                <time class="meta" datetime={cm.createdAt}>{formatDate(cm.createdAt)}</time>
              </p>
              <p class="comment-body">{cm.content}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="meta mt-2">No comments yet.</p>
      )}
    </section>

    <section class="mt-8" aria-labelledby="reply-title" id="respond">
      <h3 id="reply-title" class="post-subhead">Leave a Reply</h3>
      <CommunityForm kind="comment" song={song} heading="Leave a Reply" idSuffix="-reply" />
    </section>

    {/* ---------------- correction + report ---------------- */}
    <section class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <CommunityForm kind="correction" song={song} idSuffix="-correction" />
      <CommunityForm kind="report" song={song} idSuffix="-report" />
    </section>

    {/* ---------------- prev / next ---------------- */}
    {(adjacent.newer || adjacent.older) && (
      <nav class="post-pager" aria-label="Previous and next song">
        {adjacent.newer ? (
          <a href={songUrl(adjacent.newer, getArtist(adjacent.newer.artistId))}>
            <span class="pager-label">← Newer</span>
            {adjacent.newer.title}
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}
        {adjacent.older ? (
          <a href={songUrl(adjacent.older, getArtist(adjacent.older.artistId))}>
            <span class="pager-label">Older →</span>
            {adjacent.older.title}
          </a>
        ) : null}
      </nav>
    )}

    <p class="meta mt-8">
      Added {formatDate(song.createdAt ?? song.released)}
      {yearOf(song.released) ? ` · released ${yearOf(song.released)}` : ''} ·
      <a class="cl" href="/pages/content-policy/">content policy</a>
    </p>
  </article>

  <script>
    import { initSongPage } from '../../../components/scripts/song';
    initSongPage();
  </script>
</BaseLayout>
