---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Seo from '../../components/Seo.astro';
import SongCard from '../../components/SongCard.astro';
import { getSite, getSongsByTag, tagUrl } from '../../lib/content';
import { pluralize, truncate } from '../../lib/text';
import type { GetStaticPaths } from 'astro';
import type { Tag } from '../../lib/types';

export const getStaticPaths: GetStaticPaths = async () => {
  const { tags } = getSite();
  return tags.map((tag) => ({ params: { slug: tag.slug }, props: { tag } }));
};

const { tag } = Astro.props as { tag: Tag };
const songs = getSongsByTag(tag.id);
const description = truncate(
  tag.description || `All songs tagged “${tag.name}”.`,
  160,
);
---

<BaseLayout>
  <Seo title={`Tag: ${tag.name}`} description={description} path={tagUrl(tag)} />
  <div class="container-site py-6">
    <Breadcrumbs items={[{ name: 'Tags', url: '/lyrics/' }, { name: tag.name, url: tagUrl(tag) }]} />
    <div class="section-title">
      <h1 class="m-0">#{tag.name}</h1>
      <span class="meta">{pluralize(songs.length, 'song')}</span>
    </div>
    {tag.description && <p class="max-w-prose text-[0.9375rem] text-muted">{tag.description}</p>}
    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {songs.map((song) => <SongCard song={song} />)}
    </div>
  </div>
</BaseLayout>
