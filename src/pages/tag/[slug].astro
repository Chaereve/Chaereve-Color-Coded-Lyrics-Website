---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Seo from '../../components/Seo.astro';
import SongArchive from '../../components/SongArchive.astro';
import { getSite, getSongsByTag, tagUrl } from '../../lib/content';
import { paginateItems } from '../../lib/paginate';
import { pluralize } from '../../lib/text';
import type { GetStaticPaths } from 'astro';
import type { Song, Tag } from '../../lib/types';

export const getStaticPaths: GetStaticPaths = async () => {
  const { tags, settings } = getSite();
  const perPage = settings.songsPerPage;
  return tags.map((tag) => {
    const songs = getSongsByTag(tag.id);
    const pages = paginateItems(songs, perPage, `/tag/${tag.slug}/`);
    return { params: { slug: tag.slug }, props: { tag, page: pages[0]!, all: songs, perPage } };
  });
};

const { tag, page, all, perPage } = Astro.props as {
  tag: Tag;
  page: ReturnType<typeof paginateItems<Song>>[number];
  all: Song[];
  perPage: number;
};
---

<BaseLayout>
  <Seo
    title={`Tag: ${tag.name}`}
    description={`Songs tagged “${tag.name}” — ${pluralize(all.length, 'song')}.`}
    path={tagUrl(tag)}
  />
  <div class="container-site">
    <div class="page-head">
      <h1>Tag: {tag.name}</h1>
      <span class="meta">{pluralize(all.length, 'song')}</span>
    </div>
    {tag.description && (
      <p class="max-w-prose text-[0.9375rem]" style="color:var(--muted)">{tag.description}</p>
    )}
    <SongArchive all={all} page={page} perPage={perPage} firstUrl={`/tag/${tag.slug}`} />
  </div>
</BaseLayout>
