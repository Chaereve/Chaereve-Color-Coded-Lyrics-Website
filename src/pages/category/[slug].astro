---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Seo from '../../components/Seo.astro';
import SongArchive from '../../components/SongArchive.astro';
import { categoryUrl, getSite, getSongsByCategory } from '../../lib/content';
import { paginateItems } from '../../lib/paginate';
import { pluralize, truncate } from '../../lib/text';
import type { GetStaticPaths } from 'astro';
import type { Category } from '../../lib/types';

export const getStaticPaths: GetStaticPaths = async () => {
  const { categories, settings } = getSite();
  const perPage = settings.songsPerPage;
  return categories.map((category) => {
    const songs = getSongsByCategory(category.id);
    const pages = paginateItems(songs, perPage, `/category/${category.slug}/`);
    return {
      params: { slug: category.slug },
      props: { category, page: pages[0]!, all: songs, perPage },
    };
  });
};

const { category, page, all, perPage } = Astro.props as {
  category: Category;
  page: ReturnType<typeof paginateItems<import('../../lib/types').Song>>[number];
  all: import('../../lib/types').Song[];
  perPage: number;
};
const description = truncate(
  category.description || `All ${category.name} songs — romanization, hangul, translation and color-coded lyrics.`,
  160,
);
---

<BaseLayout>
  <Seo title={`${category.name} Archives`} description={description} path={categoryUrl(category)} />
  <div class="container-site">
    <div class="page-head">
      <h1>{category.name} Archives</h1>
      <span class="meta">{pluralize(all.length, 'song')}</span>
    </div>
    {category.description && (
      <p class="max-w-prose text-[0.9375rem]" style="color:var(--muted)">{category.description}</p>
    )}
    <SongArchive all={all} page={page} perPage={perPage} firstUrl={`/category/${category.slug}`} />
  </div>
</BaseLayout>
