# ============================================================================
# Chaereve Lyrics — environment variables (sample).
# Copy to .env for local development, or set them in Cloudflare Pages.
# NEVER commit real secrets. Placeholders marked YOUR_* must be replaced.
# ============================================================================

# ---------------- Site ----------------

# Canonical site URL (used for canonical/OG/sitemap).
# On Cloudflare Pages you can leave this empty — CF_PAGES_URL is injected.
SITE_URL=

# "owner/repo" of the CONTENT repository (links, issue fallback, CMS).
PUBLIC_GITHUB_REPO=YOUR_GITHUB_USERNAME/YOUR_REPO

# Show draft / in_review songs locally (default: false; auto-true in `npm run dev`).
SHOW_DRAFTS=false

# ---------------- Public forms (optional) ----------------

# Base URL of the forms Worker (workers/forms). When empty, forms fall back
# to a pre-filled GitHub "new issue" page.
PUBLIC_FORMS_ENDPOINT=https://YOUR_FORMS_WORKER_DOMAIN

# Cloudflare Turnstile site key (public). Secret key lives in the Worker.
PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# ---------------- Decap CMS backend ----------------

# turbo-github (default, free = 1 seat) | github (self-hosted OAuth Worker)
CMS_BACKEND=turbo-github

# Decap Turbo — from the site Overview tab (UUID).
CMS_TURBO_SITE_ID=YOUR_TURBO_SITE_ID

# GitHub backend (open authoring via the OAuth Worker).
CMS_GITHUB_REPO=YOUR_GITHUB_USERNAME/YOUR_REPO
CMS_BRANCH=main
CMS_OAUTH_BASE_URL=https://YOUR_OAUTH_WORKER_DOMAIN
CMS_OAUTH_AUTH_ENDPOINT=auth

# 1 to serve a "test" backend (rarely needed; `npx decap-server` already
# intercepts the API locally).
CMS_LOCAL_BACKEND=false

# ---------------- Worker secrets (NOT here) ----------------
# workers/oauth → wrangler secret put GITHUB_CLIENT_ID
# workers/oauth → wrangler secret put GITHUB_CLIENT_SECRET
# workers/oauth → wrangler secret put REDIRECT_URI        (optional)
# workers/forms → wrangler secret put GITHUB_TOKEN
# workers/forms → wrangler secret put GITHUB_REPO
# workers/forms → wrangler secret put TURNSTILE_SECRET_KEY
# (workers/forms ALLOWED_ORIGIN is a public var in wrangler.toml [vars])
