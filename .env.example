# ============================================================
# Environment variables — copy file này thành `.env` rồi sửa.
# KHÔNG commit file .env vào Git (đã có trong .gitignore).
# ============================================================

# URL gốc của site, dùng cho canonical URL, Open Graph, sitemap.
# Ví dụ: https://your-project.pages.dev  hoặc  https://your-domain.com
PUBLIC_SITE_URL=https://your-project.pages.dev

# Repository GitHub dạng `owner/repo`, dùng cho:
#   - Nút "Gửi correction" (mở GitHub Issue có sẵn nội dung)
#   - README / links repository
# Ví dụ: your-username/your-repo-name
PUBLIC_GITHUB_REPO=your-username/your-repo-name

# ---- Dành cho Cloudflare Worker OAuth (workers/oauth) ----
# KHÔNG đặt secret vào file này. Dùng `wrangler secret put` trên Worker.
# Xem README mục "Cloudflare Worker OAuth".
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# REDIRECT_URI=https://YOUR_DOMAIN/admin/
# STATE_SECRET=
